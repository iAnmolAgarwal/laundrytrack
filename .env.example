# Copy to .env for local development. On Vercel, set these as environment variables.

# Reads the slip photo (Claude Haiku 5.5 by default). Leave blank locally to fall back to the Claude CLI.
ANTHROPIC_API_KEY=

# Email, option 1: HTTPS relay through the Apps Script in mail_relay.example.gs (works where SMTP ports are blocked)
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=

# Email, option 2: Gmail SMTP with an app password (used when no relay URL is set)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Production only
DJANGO_SECRET_KEY=
DATABASE_URL=
CRON_SECRET=
